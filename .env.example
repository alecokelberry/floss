# Copy to .env.local for development (`pnpm bootstrap` writes one). On Vercel, Neon's integration sets the database
# variables; set BETTER_AUTH_SECRET in the project's Environment Variables.

# Postgres. Unset in development: Postgres.app at postgresql://localhost:5432/floss.
# On Vercel: Neon's pooled URL (the -pooler host).
# DATABASE_URL=

# Neon's direct connection, for migrations (a transaction pooler can't run them)
# DATABASE_URL_UNPOOLED=

# Signs sessions. Generate your own: openssl rand -base64 32 (never commit it)
BETTER_AUTH_SECRET=

# Only for a custom domain: the public URL, e.g. https://floss.example.com (*.vercel.app URLs are allowed already)
# BETTER_AUTH_URL=
