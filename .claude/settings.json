{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm knip)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm db:generate *)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:studio)",
      "Bash(pnpm bootstrap)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm install)",
      "Bash(npm view *)",
      "Bash(pnpm why *)",
      "Bash(pnpm update)",
      "Bash(pnpm audit *)",
      "Bash(pnpm audit)",
      "Bash(pnpm outdated *)",
      "Bash(pnpm outdated)",
      "Bash(pnpm exec oxlint *)",
      "Bash(pnpm exec oxfmt *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec playwright *)",
      "Bash(pnpm exec drizzle-kit generate *)",
      "Bash(pnpm exec next *)",
      "Bash(pnpm dlx shadcn@latest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(/Applications/Postgres.app/Contents/Versions/latest/bin/psql *)",
      "mcp__shadcn",
      "mcp__next-devtools",
      "mcp__better-auth"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git remote add *)",
      "Bash(pnpm exec drizzle-kit push *)",
      "Bash(vercel --prod *)",
      "Bash(vercel deploy --prod *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check.sh",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}
